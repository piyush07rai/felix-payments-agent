# ============================================================
# Felix: Enterprise AI Payments Decline Analyst Configuration
# ============================================================

# Google Gemini Configuration
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI ChatGPT Configuration (Optional - for Multi-Model & Auto-Failover)
# Obtain your API key from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Multi-Model Routing: 'gemini', 'openai', or 'fallback' (offline SQL engine)
ACTIVE_PROVIDER=gemini
ENABLE_AUTO_FAILOVER=true
LLM_TIMEOUT_SECONDS=18.0

# Application Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Storage
DATABASE_PATH=data/declines.db

# Slack App Integration (Optional / Configurable via UI)
# From Slack Developer Portal: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_ID=A0123456789

# Microsoft Teams Integration (Optional / Configurable via UI)
# From Microsoft Azure Portal App Registrations / Bot Services
TEAMS_APP_ID=your-teams-azure-app-id
TEAMS_APP_PASSWORD=your-teams-client-secret
TEAMS_TENANT_ID=your-azure-tenant-id

# Enterprise Security & Governance
DEFAULT_ORG_ID=org_primary_enterprise
ADMIN_API_KEY=your_optional_admin_secret_key
